{
  "components": {
    "schemas": {
      "AIInferenceRequest": {
        "description": "Request AI inference.\nTopic: ai/inference/request",
        "properties": {
          "inference_type": {
            "$ref": "#/components/schemas/InferenceType",
            "description": "Type of inference"
          },
          "input_data": {
            "additionalProperties": true,
            "description": "Input-specific data",
            "title": "Input Data",
            "type": "object"
          },
          "model_id": {
            "description": "Which model to use",
            "minLength": 1,
            "title": "Model Id",
            "type": "string"
          },
          "msg_id": {
            "description": "Unique message identifier (UUID4)",
            "format": "uuid",
            "title": "Msg Id",
            "type": "string"
          },
          "options": {
            "additionalProperties": true,
            "description": "Inference options",
            "title": "Options",
            "type": "object"
          },
          "source": {
            "description": "Service name that created the message",
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "timestamp": {
            "description": "Creation timestamp in UTC",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "default": "1.0.0",
            "description": "Schema version (semver)",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "source",
          "inference_type",
          "model_id",
          "input_data"
        ],
        "title": "AIInferenceRequest",
        "type": "object"
      },
      "AIInferenceResponse": {
        "description": "AI inference result.\nTopic: ai/inference/response",
        "properties": {
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error if any",
            "title": "Error Message"
          },
          "inference_type": {
            "$ref": "#/components/schemas/InferenceType",
            "description": "Type of inference"
          },
          "model_id": {
            "minLength": 1,
            "title": "Model Id",
            "type": "string"
          },
          "msg_id": {
            "description": "Unique message identifier (UUID4)",
            "format": "uuid",
            "title": "Msg Id",
            "type": "string"
          },
          "processing_time_ms": {
            "minimum": 0.0,
            "title": "Processing Time Ms",
            "type": "integer"
          },
          "request_id": {
            "description": "Matches request msg_id",
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/InferenceResult"
            },
            "title": "Results",
            "type": "array"
          },
          "source": {
            "description": "Service name that created the message",
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "success": {
            "description": "Whether inference succeeded",
            "title": "Success",
            "type": "boolean"
          },
          "timestamp": {
            "description": "Creation timestamp in UTC",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "default": "1.0.0",
            "description": "Schema version (semver)",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "source",
          "request_id",
          "inference_type",
          "model_id",
          "processing_time_ms",
          "success"
        ],
        "title": "AIInferenceResponse",
        "type": "object"
      },
      "Body_upload_model_api_models_upload_post": {
        "properties": {
          "activate": {
            "default": "false",
            "title": "Activate",
            "type": "string"
          },
          "file": {
            "format": "binary",
            "title": "File",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "file",
          "id",
          "type"
        ],
        "title": "Body_upload_model_api_models_upload_post",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InferenceResult": {
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          }
        },
        "required": [
          "label",
          "confidence"
        ],
        "title": "InferenceResult",
        "type": "object"
      },
      "InferenceType": {
        "enum": [
          "image_classification",
          "object_detection",
          "qa"
        ],
        "title": "InferenceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
