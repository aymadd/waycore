{
  "components": {
    "schemas": {
      "ContactUpdate": {
        "description": "Request body for updating contact info.",
        "properties": {
          "alias": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alias"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "title": "ContactUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeshMessageCreate": {
        "description": "Schema for creating a new mesh message.",
        "properties": {
          "channel": {
            "default": 0,
            "description": "Channel index",
            "maximum": 7.0,
            "minimum": 0.0,
            "title": "Channel",
            "type": "integer"
          },
          "text": {
            "description": "Message text",
            "maxLength": 237,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "to_node": {
            "anyOf": [
              {
                "pattern": "^![0-9a-fA-F]{8}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recipient node ID (None = broadcast)",
            "title": "To Node"
          },
          "want_ack": {
            "default": true,
            "description": "Request delivery acknowledgment",
            "title": "Want Ack",
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ],
        "title": "MeshMessageCreate",
        "type": "object"
      },
      "Priority": {
        "enum": [
          "low",
          "normal",
          "high",
          "urgent"
        ],
        "title": "Priority",
        "type": "string"
      },
      "SendMessageRequest": {
        "description": "Request to send a message via a radio.\nTopic: comms/message/send",
        "properties": {
          "channel": {
            "default": "primary",
            "description": "Channel name",
            "minLength": 1,
            "title": "Channel",
            "type": "string"
          },
          "content": {
            "description": "Message text",
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "msg_id": {
            "description": "Unique message identifier (UUID4)",
            "format": "uuid",
            "title": "Msg Id",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority",
            "default": "normal",
            "description": "Message priority"
          },
          "source": {
            "description": "Service name that created the message",
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "timestamp": {
            "description": "Creation timestamp in UTC",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "to_node": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recipient (None=broadcast)",
            "title": "To Node"
          },
          "transport": {
            "$ref": "#/components/schemas/Transport",
            "description": "Transport type"
          },
          "version": {
            "default": "1.0.0",
            "description": "Schema version (semver)",
            "title": "Version",
            "type": "string"
          },
          "want_ack": {
            "default": false,
            "description": "Request acknowledgment",
            "title": "Want Ack",
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "transport",
          "content"
        ],
        "title": "SendMessageRequest",
        "type": "object"
      },
      "Transport": {
        "enum": [
          "lora",
          "wifi",
          "lte",
          "bluetooth"
        ],
        "title": "Transport",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
