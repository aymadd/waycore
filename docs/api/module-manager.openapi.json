{
  "info": {
    "description": "API specification for the Waycore module-manager service.",
    "title": "Module Manager API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/modules": {
      "get": {
        "operationId": "modules_api_modules_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Modules Api Modules Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Modules"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://localhost:8005"
    },
    {
      "description": "Docker network",
      "url": "http://module-manager:8005"
    }
  ]
}
