{
  "components": {
    "schemas": {
      "BatteryResponse": {
        "description": "Response for /api/system/battery endpoint.",
        "properties": {
          "estimated_minutes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Estimated minutes remaining (None if charging)",
            "title": "Estimated Minutes"
          },
          "is_charging": {
            "description": "Whether battery is charging",
            "title": "Is Charging",
            "type": "boolean"
          },
          "level": {
            "description": "Battery level 0-100%",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Level",
            "type": "integer"
          },
          "voltage": {
            "description": "Battery voltage",
            "exclusiveMinimum": 0.0,
            "title": "Voltage",
            "type": "number"
          }
        },
        "required": [
          "level",
          "is_charging",
          "voltage"
        ],
        "title": "BatteryResponse",
        "type": "object"
      },
      "CommandType": {
        "enum": [
          "sos_trigger",
          "sos_cancel",
          "radio_enable",
          "radio_disable",
          "shutdown",
          "reboot",
          "enter_low_power"
        ],
        "title": "CommandType",
        "type": "string"
      },
      "CompassResponse": {
        "description": "Response for /api/sensors/compass endpoint.",
        "properties": {
          "accuracy_degrees": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Accuracy in degrees",
            "title": "Accuracy Degrees"
          },
          "calibrated": {
            "description": "Whether compass is calibrated",
            "title": "Calibrated",
            "type": "boolean"
          },
          "declination": {
            "default": 0.0,
            "description": "Magnetic declination",
            "title": "Declination",
            "type": "number"
          },
          "elevation_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Elevation in meters",
            "title": "Elevation M"
          },
          "gps_accuracy_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "GPS accuracy in meters",
            "title": "Gps Accuracy M"
          },
          "heading_cardinal": {
            "description": "Cardinal direction (N, NE, E, etc.)",
            "title": "Heading Cardinal",
            "type": "string"
          },
          "heading_degrees": {
            "description": "Heading in degrees (0=N)",
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Heading Degrees",
            "type": "number"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Latitude in degrees",
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Longitude in degrees",
            "title": "Longitude"
          },
          "timestamp": {
            "description": "Reading timestamp",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "heading_degrees",
          "heading_cardinal",
          "calibrated",
          "timestamp"
        ],
        "title": "CompassResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SystemCommand": {
        "description": "Command directed to the system.\nTopic: system/command/execute",
        "properties": {
          "command": {
            "$ref": "#/components/schemas/CommandType",
            "description": "Command type"
          },
          "msg_id": {
            "description": "Unique message identifier (UUID4)",
            "format": "uuid",
            "title": "Msg Id",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "description": "Command parameters",
            "title": "Parameters",
            "type": "object"
          },
          "source": {
            "description": "Service name that created the message",
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "timestamp": {
            "description": "Creation timestamp in UTC",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "default": "1.0.0",
            "description": "Schema version (semver)",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "source",
          "command"
        ],
        "title": "SystemCommand",
        "type": "object"
      },
      "SystemInfoResponse": {
        "description": "Response for /api/system/info endpoint.",
        "properties": {
          "app_version": {
            "description": "Application version",
            "title": "App Version",
            "type": "string"
          },
          "build_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Build date if available",
            "title": "Build Date"
          },
          "device_model": {
            "description": "Device model (e.g., Raspberry Pi 5)",
            "title": "Device Model",
            "type": "string"
          },
          "hostname": {
            "description": "Device hostname",
            "title": "Hostname",
            "type": "string"
          },
          "os_version": {
            "description": "Operating system version",
            "title": "Os Version",
            "type": "string"
          },
          "python_version": {
            "description": "Python version",
            "title": "Python Version",
            "type": "string"
          }
        },
        "required": [
          "app_version",
          "device_model",
          "os_version",
          "python_version",
          "hostname"
        ],
        "title": "SystemInfoResponse",
        "type": "object"
      },
      "SystemTimeResponse": {
        "description": "Response for /api/system/time endpoint.",
        "properties": {
          "timestamp": {
            "description": "Current system time in UTC",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "timezone": {
            "description": "System timezone (e.g., 'UTC', 'America/New_York')",
            "title": "Timezone",
            "type": "string"
          },
          "uptime_seconds": {
            "description": "System uptime in seconds",
            "minimum": 0.0,
            "title": "Uptime Seconds",
            "type": "integer"
          }
        },
        "required": [
          "timestamp",
          "timezone",
          "uptime_seconds"
        ],
        "title": "SystemTimeResponse",
        "type": "object"
      },
      "TemperatureResponse": {
        "description": "Response for /api/system/temperature endpoint.",
        "properties": {
          "celsius": {
            "description": "Temperature in Celsius",
            "title": "Celsius",
            "type": "number"
          },
          "source": {
            "description": "Sensor source (mock, cpu, external)",
            "title": "Source",
            "type": "string"
          },
          "timestamp": {
            "description": "Reading timestamp",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "celsius",
          "source",
          "timestamp"
        ],
        "title": "TemperatureResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API specification for the Waycore core-daemon service.",
    "title": "Core Daemon API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/command": {
      "post": {
        "operationId": "command_api_command_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Command Api Command Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Command"
      }
    },
    "/api/sensors/compass": {
      "get": {
        "description": "Get compass/magnetometer reading with GPS and elevation.",
        "operationId": "get_compass_api_sensors_compass_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompassResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Compass"
      }
    },
    "/api/sensors/compass/calibrate": {
      "post": {
        "description": "Start compass calibration (mock: instant success).",
        "operationId": "calibrate_compass_api_sensors_compass_calibrate_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Calibrate Compass Api Sensors Compass Calibrate Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Calibrate Compass"
      }
    },
    "/api/sensors/compass/heading": {
      "post": {
        "description": "Set compass heading (for testing).",
        "operationId": "set_compass_heading_api_sensors_compass_heading_post",
        "parameters": [
          {
            "in": "query",
            "name": "heading",
            "required": true,
            "schema": {
              "title": "Heading",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Set Compass Heading Api Sensors Compass Heading Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Compass Heading"
      }
    },
    "/api/sensors/registry": {
      "get": {
        "description": "Get all registered sensors.\n\nReturns a list of sensor info including status, last reading, etc.",
        "operationId": "get_all_sensors_api_sensors_registry_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get All Sensors Api Sensors Registry Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get All Sensors"
      }
    },
    "/api/sensors/registry/discover": {
      "post": {
        "description": "Run sensor discovery.\n\nThis scans for available sensors and registers them.\nIn mock mode, registers mock sensors for development.",
        "operationId": "discover_sensors_api_sensors_registry_discover_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Discover Sensors Api Sensors Registry Discover Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Discover Sensors"
      }
    },
    "/api/sensors/registry/type/{sensor_type}": {
      "get": {
        "description": "Get all sensors of a specific type.",
        "operationId": "get_sensors_by_type_api_sensors_registry_type__sensor_type__get",
        "parameters": [
          {
            "in": "path",
            "name": "sensor_type",
            "required": true,
            "schema": {
              "title": "Sensor Type",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Sensors By Type Api Sensors Registry Type  Sensor Type  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Sensors By Type"
      }
    },
    "/api/sensors/registry/{sensor_id}": {
      "get": {
        "description": "Get a specific sensor by ID.",
        "operationId": "get_sensor_api_sensors_registry__sensor_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "sensor_id",
            "required": true,
            "schema": {
              "title": "Sensor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Sensor Api Sensors Registry  Sensor Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Sensor"
      }
    },
    "/api/status": {
      "get": {
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Status Api Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status"
      }
    },
    "/api/system/battery": {
      "get": {
        "description": "Get battery status.",
        "operationId": "get_battery_api_system_battery_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatteryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Battery"
      }
    },
    "/api/system/battery/charging": {
      "post": {
        "description": "Toggle charging state (for testing).",
        "operationId": "set_charging_api_system_battery_charging_post",
        "parameters": [
          {
            "in": "query",
            "name": "enabled",
            "required": true,
            "schema": {
              "title": "Enabled",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Set Charging Api System Battery Charging Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Charging"
      }
    },
    "/api/system/factory-reset": {
      "post": {
        "description": "Factory reset: clears all user data and resets to defaults.\n\nThis endpoint resets:\n- All mock sensor states to defaults\n- User preferences (via data-logger)\n- Notes (via data-logger)\n- Event logs (via data-logger)",
        "operationId": "factory_reset_api_system_factory_reset_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Factory Reset Api System Factory Reset Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Factory Reset"
      }
    },
    "/api/system/info": {
      "get": {
        "description": "Get system information.",
        "operationId": "get_system_info_api_system_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get System Info"
      }
    },
    "/api/system/storage": {
      "get": {
        "description": "Get storage usage information.\n\nReturns breakdown of storage by category:\n- total_bytes: Total storage capacity (mocked for dev)\n- system_bytes: OS and system files (mocked)\n- apps_bytes: Application installation size (mocked)\n- data_bytes: User data (calculated from actual files)\n- available_bytes: Free space",
        "operationId": "get_storage_status_api_system_storage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Storage Status Api System Storage Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Storage Status"
      }
    },
    "/api/system/temperature": {
      "get": {
        "description": "Get temperature reading.",
        "operationId": "get_temperature_api_system_temperature_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemperatureResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Temperature"
      }
    },
    "/api/system/time": {
      "get": {
        "description": "Get current system time and timezone.",
        "operationId": "get_system_time_api_system_time_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemTimeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get System Time"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://localhost:8001"
    },
    {
      "description": "Docker network",
      "url": "http://core-daemon:8001"
    }
  ]
}
