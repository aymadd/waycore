{
  "components": {
    "schemas": {
      "CameraSettingsResponse": {
        "description": "Camera settings response.",
        "properties": {
          "available_resolutions": {
            "description": "List of supported resolutions",
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Available Resolutions",
            "type": "array"
          },
          "is_front_camera": {
            "description": "Whether front camera is active",
            "title": "Is Front Camera",
            "type": "boolean"
          },
          "resolution_height": {
            "description": "Current image height in pixels",
            "title": "Resolution Height",
            "type": "integer"
          },
          "resolution_width": {
            "description": "Current image width in pixels",
            "title": "Resolution Width",
            "type": "integer"
          }
        },
        "required": [
          "resolution_width",
          "resolution_height",
          "is_front_camera",
          "available_resolutions"
        ],
        "title": "CameraSettingsResponse",
        "type": "object"
      },
      "CameraSettingsUpdate": {
        "description": "Request body for updating camera settings.",
        "properties": {
          "resolution_height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Image height in pixels",
            "title": "Resolution Height"
          },
          "resolution_width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Image width in pixels",
            "title": "Resolution Width"
          },
          "use_front_camera": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Switch to front camera",
            "title": "Use Front Camera"
          }
        },
        "title": "CameraSettingsUpdate",
        "type": "object"
      },
      "CameraStateEnum": {
        "description": "Camera operational states.",
        "enum": [
          "uninitialized",
          "ready",
          "capturing",
          "error"
        ],
        "title": "CameraStateEnum",
        "type": "string"
      },
      "CameraStatusResponse": {
        "description": "Camera status response.",
        "properties": {
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error message if any",
            "title": "Error Message"
          },
          "is_front_camera": {
            "description": "Whether front camera is active",
            "title": "Is Front Camera",
            "type": "boolean"
          },
          "is_ready": {
            "description": "Whether camera is ready for capture",
            "title": "Is Ready",
            "type": "boolean"
          },
          "resolution": {
            "description": "Current resolution (width, height)",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Resolution",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/CameraStateEnum",
            "description": "Current camera state"
          }
        },
        "required": [
          "state",
          "is_ready",
          "resolution",
          "is_front_camera"
        ],
        "title": "CameraStatusResponse",
        "type": "object"
      },
      "CaptureResponse": {
        "description": "Response from photo capture.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error message if failed",
            "title": "Error"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoMetadata"
              },
              {
                "type": "null"
              }
            ],
            "description": "Photo metadata if successful"
          },
          "success": {
            "description": "Whether capture was successful",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "title": "CaptureResponse",
        "type": "object"
      },
      "DeletePhotoResponse": {
        "description": "Response for photo deletion.",
        "properties": {
          "id": {
            "description": "ID of deleted photo",
            "title": "Id",
            "type": "string"
          },
          "success": {
            "description": "Whether deletion was successful",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "id"
        ],
        "title": "DeletePhotoResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PhotoListResponse": {
        "description": "Response for photo listing.",
        "properties": {
          "photos": {
            "description": "List of photos",
            "items": {
              "$ref": "#/components/schemas/PhotoMetadata"
            },
            "title": "Photos",
            "type": "array"
          },
          "total": {
            "description": "Total number of photos",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "photos",
          "total"
        ],
        "title": "PhotoListResponse",
        "type": "object"
      },
      "PhotoMetadata": {
        "description": "Photo metadata.",
        "properties": {
          "filename": {
            "description": "Original filename",
            "title": "Filename",
            "type": "string"
          },
          "filepath": {
            "description": "Full path to file",
            "title": "Filepath",
            "type": "string"
          },
          "height": {
            "description": "Image height in pixels",
            "title": "Height",
            "type": "integer"
          },
          "id": {
            "description": "Unique photo identifier (filename without extension)",
            "title": "Id",
            "type": "string"
          },
          "size_bytes": {
            "description": "File size in bytes",
            "title": "Size Bytes",
            "type": "integer"
          },
          "timestamp": {
            "description": "When photo was taken",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "width": {
            "description": "Image width in pixels",
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "filename",
          "filepath",
          "timestamp",
          "width",
          "height",
          "size_bytes"
        ],
        "title": "PhotoMetadata",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API specification for the Waycore camera-service service.",
    "title": "Camera Service API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/camera/capture": {
      "post": {
        "description": "Capture a photo.",
        "operationId": "capture_photo_api_camera_capture_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capture Photo"
      }
    },
    "/api/camera/settings": {
      "get": {
        "description": "Get current camera settings.",
        "operationId": "get_camera_settings_api_camera_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraSettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Camera Settings"
      },
      "put": {
        "description": "Update camera settings.",
        "operationId": "update_camera_settings_api_camera_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraSettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraSettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Camera Settings"
      }
    },
    "/api/camera/status": {
      "get": {
        "description": "Get current camera status.",
        "operationId": "get_camera_status_api_camera_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Camera Status"
      }
    },
    "/api/photos": {
      "get": {
        "description": "List all photos.",
        "operationId": "list_photos_api_photos_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Photos"
      }
    },
    "/api/photos/{photo_id}": {
      "delete": {
        "description": "Delete a photo by ID.",
        "operationId": "delete_photo_api_photos__photo_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "photo_id",
            "required": true,
            "schema": {
              "title": "Photo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletePhotoResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Photo"
      },
      "get": {
        "description": "Get photo metadata by ID.",
        "operationId": "get_photo_api_photos__photo_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "photo_id",
            "required": true,
            "schema": {
              "title": "Photo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoMetadata"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Photo"
      }
    },
    "/api/photos/{photo_id}/file": {
      "get": {
        "description": "Get photo file by ID.",
        "operationId": "get_photo_file_api_photos__photo_id__file_get",
        "parameters": [
          {
            "in": "path",
            "name": "photo_id",
            "required": true,
            "schema": {
              "title": "Photo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Photo File"
      }
    },
    "/health": {
      "get": {
        "description": "Health check endpoint.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://localhost:8006"
    },
    {
      "description": "Docker network",
      "url": "http://camera-service:8006"
    }
  ]
}
